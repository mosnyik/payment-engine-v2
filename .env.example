DATABASE_URL=postgres://payment_engine:local_dev_only@localhost:5433/payment_engine?sslmode=disable

# APP_ENV=development enables the local-dev DATABASE_URL check to pass.
# Set APP_ENV=production in real deployments — this also rejects a
# DATABASE_URL that still matches the local-dev default above.
APP_ENV=development

# All of the below are optional — shown here with their defaults.
# HMAC_CLOCK_SKEW=5m
# ADMIN_SESSION_TTL=12h
# EVENTBUS_BATCH_SIZE=50
