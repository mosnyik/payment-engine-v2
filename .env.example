DATABASE_URL=postgres://payment_engine:local_dev_only@localhost:5433/2settle?sslmode=disable

# Separate database for `go test ./...` — keeps test fixture data out of
# your dev database. Point it at any Postgres reachable from your machine;
# this default assumes the dockerized one (docker compose up -d postgres).
TEST_DATABASE_URL=postgres://payment_engine:local_dev_only@localhost:5433/2settle?sslmode=disable

# 32 bytes hex — encrypts tenant credentials (e.g. HMAC secrets) at rest.
# Generate a real one for anything beyond local dev: openssl rand -hex 32
TENANT_SECRET_ENCRYPTION_KEY=REPLACE_WITH_YOUR_OWN_32_BYTE_HEX_KEY

# APP_ENV=development enables the local-dev DATABASE_URL/encryption-key
# checks to pass. Set APP_ENV=production in real deployments — this also
# rejects either value if it still matches the local-dev default above.
APP_ENV=development

# All of the below are optional — shown here with their defaults.
# HMAC_CLOCK_SKEW=5m
# ADMIN_SESSION_TTL=12h
# EVENTBUS_BATCH_SIZE=50
# HTTP_ADDR=:3700

# Phase 9 (security hardening) — outbox_events/request_audit_log cleanup
# jobs. Retention defaults to 12 months for both; OUTBOX_* is operational
# hygiene on a hot-write table, not a compliance window, and happens to
# share AUDIT_LOG_*'s default value today rather than being the same knob.
# OUTBOX_RETENTION=8760h
# OUTBOX_CLEANUP_INTERVAL=24h
# AUDIT_LOG_RETENTION=8760h
# AUDIT_LOG_RETENTION_CHECK_INTERVAL=24h

# Rate engine (internal/rate). COINMARKETCAP_API_KEY is REQUIRED: cmd/ratefetcher
# exits at startup without it (it fetches the USD/<fiat> rate from
# CoinMarketCap — see the cmd/ratefetcher section below), and cmd/server uses
# the same key to price non-USDT crypto assets. Everything else here is
# optional; the external rate providers below are TODO stubs (no real
# endpoint wired in yet) and stay disabled until one is.
COINMARKETCAP_API_KEY=
# RATE_FETCH_INTERVAL=30s
# BUSHA_RATE_ENABLED=false
# BUSHA_RATE_API_URL=
# BUSHA_RATE_API_KEY=
# LIQUIDRAMP_RATE_ENABLED=false
# LIQUIDRAMP_RATE_API_URL=
# LIQUIDRAMP_RATE_API_KEY=
# ANCHOR_RATE_ENABLED=false
# ANCHOR_RATE_API_URL=
# ANCHOR_RATE_API_KEY=

# Busha Business crypto collection. See docs/BUSHA_SANDBOX.md.
# Separate from BUSHA_RATE_*; collection uses the secret API key.
# BUSHA_TREASURY_ENABLED=false
# BUSHA_TREASURY_API_URL=https://api.sandbox.busha.so
# BUSHA_TREASURY_API_KEY=
# BUSHA_TREASURY_WEBHOOK_SECRET=
# In the app's sandbox deployment, select Busha instead of fake deposits:
# SANDBOX_COLLECTION_PROVIDER=busha
# SANDBOX_CORRIDORS=USDT:TRX:NGN

# Treasury (internal/treasury) — Phase 4 step 2, self-custody HD wallets.
# Optional (unlike TENANT_SECRET_ENCRYPTION_KEY): no HTTP routes call this
# yet, so a deployment that leaves it unset just can't load the wallet.
# 32 bytes hex — decrypts the seed row hd_wallet_seed stores (populated
# once by `adminctl -init-wallet`). Generate a real one the same way as
# TENANT_SECRET_ENCRYPTION_KEY: openssl rand -hex 32
# HD_WALLET_SEED_ENCRYPTION_KEY=

# Per-chain watcher/broadcaster settings — all optional, disabled by
# default. APIURL is a REST explorer endpoint (Blockstream/Etherscan V2/an
# EVM RPC URL) for bitcoin/ethereum/bsc, or a gRPC host:port (e.g.
# grpc.trongrid.io:50051) for tron. MIN_CONFIRMATIONS defaults shown below
# match v1's hardcoded thresholds.
# BITCOIN_ENABLED=false
# BITCOIN_API_URL=
# BITCOIN_API_KEY=
# BITCOIN_MIN_CONFIRMATIONS=2
# ETHEREUM_ENABLED=false
# ETHEREUM_API_URL=
# ETHEREUM_API_KEY=
# ETHEREUM_MIN_CONFIRMATIONS=12
# BSC_ENABLED=false
# BSC_API_URL=
# BSC_API_KEY=
# BSC_MIN_CONFIRMATIONS=15
# TRON_ENABLED=false
# TRON_API_URL=
# TRON_API_KEY=
# TRON_MIN_CONFIRMATIONS=19

# WATCHER_POLL_INTERVAL=30s

# Stable-asset (USDT-*) batch sweep policy — volatile assets always sweep
# immediately, no config needed for that path. No v1 equivalent; these are
# this system's own defaults, not ported.
# SWEEP_STABLE_BALANCE_THRESHOLD=1000
# SWEEP_STABLE_TIME_BACKSTOP=6h

# Minimal tenant-custom-wallet notification sender (deposit detected/
# confirmed webhooks) — intentionally smaller in scope than Phase 7
# (notification) will eventually be: bounded retries, no persistent
# delivery log.
# TENANT_WEBHOOK_TIMEOUT=10s
# TENANT_WEBHOOK_MAX_RETRIES=3

# Hyparrow — the live NGN bank-payout settlement provider (same env names as
# v1). Disabled unless HYPARROW_ENABLED=true AND every credential and sender
# field is set. Sender fields describe 2Settle as the business sending the
# payout. Bind it to a corridor as a settlement provider named "hyparrow"
# (PUT /admin/corridors/{id}/providers), and set that corridor's
# required_destination_fields to account_number, bank_code, account_name.
# Webhook URL to register with Hyparrow: <base>/v2/webhooks/settlement/hyparrow
# HYPARROW_ENABLED=false
# HYPARROW_BASE_URL=https://sandbox.hyparrow.cloud/api/v1
# HYPARROW_API_KEY=
# HYPARROW_API_SECRET=
# HYPARROW_WEBHOOK_SECRET=
# HYPARROW_SENDER_PHONE=
# HYPARROW_SENDER_EMAIL=
# HYPARROW_SENDER_LASTNAME=
# HYPARROW_SENDER_OTHERNAMES=
# HYPARROW_TIMEOUT=30s

# Telegram manual-payout fallback (same env names as v1). When automatic
# payout gives up with nothing in flight, the payout details are posted to
# this chat with a "Settlement completed" button instead of the settlement
# going straight to settlement_failed. Register the bot webhook with
# setWebhook url=<base>/v2/webhooks/telegram secret_token=$TELEGRAM_WEBHOOK_SECRET
# — without the secret, alerts still send but button presses are refused.
# TELEGRAM_ALERTS_ENABLED=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET=

# Notification (internal/notification) — Phase 7. Tenant webhook delivery
# needs no config here (destination/secret come from each tenant's own
# webhook_url via /admin/tenants/{id}/webhook). NOTIFICATION_OPS_ALERT_EMAIL
# is where settlement.failed/settlement.reversed/compliance.hold_created
# get sent — leave unset and that channel is silently skipped, same as a
# tenant with no webhook configured.
# NOTIFICATION_DISPATCH_POLL_INTERVAL=15s
# NOTIFICATION_OPS_ALERT_EMAIL=

# Email adapter — disabled unless NOTIFICATION_EMAIL_PROVIDER is set to a
# recognized vendor name. "resend" is a real, working integration (not a
# TODO stub like the rate/settlement providers above) — sign up at
# resend.com, verify a sending domain, and use that domain's address as
# NOTIFICATION_EMAIL_FROM_ADDRESS. An unset/unrecognized provider name
# falls back to a stub that dead-letters every delivery immediately.
# NOTIFICATION_EMAIL_ENABLED=false
# NOTIFICATION_EMAIL_PROVIDER=resend
# NOTIFICATION_EMAIL_API_KEY=
# NOTIFICATION_EMAIL_FROM_ADDRESS=
# NOTIFICATION_EMAIL_API_URL=
# Display name shown next to FROM_ADDRESS in the recipient's inbox (e.g.
# "2Settle <noreply@api.2settle.io>") — optional, falls back to the bare
# address when unset.
# NOTIFICATION_EMAIL_FROM_NAME=2Settle

# Tenant self-service portal: the frontend sends its own "portal_url" (e.g.
# "https://app.2settle.io/dashboard") on POST /v2/portal/login and
# /v2/portal/register, and the magic-link email links to
# "{portal_url}/verify?token=...". That page should call
# GET /v2/portal/verify?token=... on this API. portal_url is required and its
# origin (scheme://host[:port], no path) must be on this comma-separated
# allowlist — otherwise anyone could have a victim's login link point at
# their own site. Any path under an allowed origin works without changing
# this. Empty (the default) rejects every portal_url, so no login links go out.
# PORTAL_ALLOWED_ORIGINS=https://app.2settle.io,http://localhost:3000

# KYB screening via Youverify (internal/compliance/youverify_provider.go).
# When enabled, self-service KYB submissions are checked against CAC (RC
# number), the business TIN and the director's BVN. Definite failures are
# rejected; everything else, including a clean pass, goes to the admin hold
# queue with the findings attached, for an admin to approve. Disabled: every
# submission goes to the hold queue unchecked. Ignored when SANDBOX_MODE=true
# (sandbox always auto-approves and never bills a vendor).
# API_URL: https://api.youverify.co (live, billed) or
# https://api.sandbox.youverify.co (test data).
# YOUVERIFY_ENABLED=false
# YOUVERIFY_API_URL=https://api.youverify.co
# YOUVERIFY_API_KEY=

# cmd/ratefetcher — a separate binary/container from the main server (see
# docker-compose.yml), so it does NOT read any of the vars above, only
# DATABASE_URL, COINMARKETCAP_API_KEY (required — set it in the rate engine
# section above) and these. Fetches the USD/<fiat> rate from CoinMarketCap
# (Tether's price in that currency, by CoinMarketCap ID 825) and writes it
# into provider_rates as the "coinmarketcap" provider. The interval is
# namespaced as RATEFETCHER_* rather than reusing RATE_FETCH_INTERVAL above,
# which is a different binary's (cmd/server's in-process rate.FetchJob) knob.
# At 20m the fetcher spends ~2,200 of the free plan's 10,000 monthly credits.
# COINMARKETCAP_API_URL=https://pro-api.coinmarketcap.com
# RATEFETCHER_FIAT_CURRENCY=NGN
# RATEFETCHER_FETCH_INTERVAL=20m
